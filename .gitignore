# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary
*.test

# Output of go coverage
*.out
coverage.txt
junit.xml

# Go workspace
go.work
go.work.sum

# Dependency directories
vendor/

# Build output
/dist/
/out/
/tmp/

# Pre-commit hook tool installs (govulncheck, etc.)
.bin/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Config with secrets (use config.example.yaml instead)
config.yaml
.env

# Local deploy overrides (real host rules, real hostnames) -- keep a
# generic compose.yaml checked in; per-deployment specifics go in a
# gitignored override that `docker compose` merges in automatically.
compose.override.yaml
compose.override.yml

# Pre-commit
.pre-commit-config.yaml.backup

# Claude Code project state (plans, worktrees, local settings) -- mirrors
# branchDAM's own .gitignore. .claude/settings.json and
# .claude/hooks/session-start.sh are intentionally committed (see
# CLAUDE.md's SessionStart hook doc) and stay tracked regardless of this
# pattern -- gitignore never untracks a file already in the index, it only
# keeps everything else under .claude/ (plans, scheduled-task state,
# worktrees) from showing up as untracked clutter.
.claude/

# Agent workspace (superpowers plans, scratch) -- mirrors branchDAM's own
# .gitignore; no such directory exists in this repo yet.
/docs/superpowers/
